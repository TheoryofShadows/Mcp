# MCPX Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# ─── Express API ──────────────────────────────────────────────────────────────
PORT=3001

# REQUIRED in production: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# SQLite database path
# Local dev default: server/mcpx.db (relative to the server directory)
# Railway production: mount a volume at /data and set this to /data/mcpx.db
#   → Service → Volumes → Add Volume → Mount Path: /data
# DB_PATH=/data/mcpx.db

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Override API base URL for Vercel / production deployments
# VITE_API_BASE_URL=https://your-api.railway.app

# Your main Vercel deployment URL (no trailing slash).
# Set this in Vercel → Project Settings → Environment Variables for ALL
# environments (Production + Preview + Development).
#
# Why: Supabase requires OAuth redirect URLs to be whitelisted. Pointing
# every deployment at one fixed origin means only ONE entry is needed in
# Supabase's Redirect URL list — no custom domain required, completely free.
#
# Alternative: leave VITE_APP_URL unset and add the wildcard
#   https://*.vercel.app/auth/callback
# to Supabase → Authentication → URL Configuration → Redirect URLs instead.
# VITE_APP_URL=https://your-project.vercel.app

# ─── Supabase (GitHub OAuth) ──────────────────────────────────────────────────
# Required for GitHub login. Get values from Supabase → Project Settings → API.
# Set all four in your deployment platform's environment variables.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend service role key (bypasses RLS — NEVER expose to the browser)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Descope (Admin Auth) ─────────────────────────────────────────────────────
# Required for admin panel access. Get from Descope console → Project Settings.
# VITE_DESCOPE_PROJECT_ID=your-descope-project-id
# DESCOPE_PROJECT_ID=your-descope-project-id
# Admin permission ID — from Descope console → Authorization → Permissions.
# VITE_DESCOPE_ADMIN_PERMISSION=your-permission-id
# DESCOPE_ADMIN_PERMISSION=your-permission-id

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Set STRIPE_SECRET_KEY in your deployment env vars — never commit the real key.
# STRIPE_SECRET_KEY=rk_live_...       ← set in Railway, not here
# STRIPE_WEBHOOK_SECRET=whsec_...     ← from Stripe Dashboard → Webhooks
# APP_URL=https://your-app.railway.app  ← used for checkout success/cancel URLs
# Optional: pin Price IDs (auto-created on first use if not set)
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_ENTERPRISE=price_yyy
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Solana Pay (coming soon) ─────────────────────────────────────────────────
# SOLANA_PAY_MERCHANT_WALLET=your-solana-wallet-address
