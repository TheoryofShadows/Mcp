# MCPX Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# ─── Express API ──────────────────────────────────────────────────────────────
PORT=3001

# REQUIRED in production: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# SQLite database path (default: server/mcpx.db)
# DB_PATH=./server/mcpx.db

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Override API base URL for Vercel / production deployments
# VITE_API_BASE_URL=https://your-api.railway.app

# ─── Supabase (optional) ──────────────────────────────────────────────────────
# If set, the frontend will use Supabase instead of the local SQLite API.
# Leave blank to use the Express + SQLite backend (default for local dev).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend service role key (bypasses RLS — NEVER expose to the browser)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Stripe (coming soon) ─────────────────────────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Solana Pay (coming soon) ─────────────────────────────────────────────────
# SOLANA_PAY_MERCHANT_WALLET=your-solana-wallet-address
