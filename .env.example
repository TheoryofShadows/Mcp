# MCPX Environment Configuration
# Copy this file to .env and fill in your values

# ─── Stripe (optional – not yet integrated) ──────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Express API ─────────────────────────────────────────────────────────────
PORT=3001
# CRITICAL: Set a strong random secret in production. The server falls back to
# an insecure default if this is missing, which allows token forgery.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
