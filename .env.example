# MCPX Environment Configuration
# Copy this file to .env and update the values

# Server port (default: 3001)
PORT=3001

# JWT secret for access tokens (15-minute expiry)
# IMPORTANT: Change this to a secure random string in production
JWT_SECRET=change-me-to-a-secure-random-string

# Refresh token secret (30-day expiry)
# Should be different from JWT_SECRET
REFRESH_SECRET=change-me-to-a-different-secure-string

# CORS allowed origins (comma-separated)
# In production, set this to your actual domain
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Node environment (development | production | test)
NODE_ENV=development
