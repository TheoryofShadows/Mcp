{
  "name": "mcpx",
  "private": true,
  "version": "1.0.0",
  "description": "MCPX — The Marketplace for AI Agent Tools (MCP Servers). Discover, install, and publish Model Context Protocol servers for Claude, Cursor, and VS Code.",
  "keywords": [
    "mcp",
    "mcpx",
    "model-context-protocol",
    "ai-agents",
    "marketplace",
    "claude",
    "cursor",
    "vscode",
    "llm-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheoryofShadows/Mcp.git"
  },
  "license": "MIT",
  "author": "TheoryofShadows",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -e .env -- concurrently \"vite\" \"node server/index.js\"",
    "dev:client": "dotenv -e .env -- vite",
    "dev:server": "dotenv -e .env -- node server/index.js",
    "build": "vite build",
    "seed": "node server/seed.js",
    "start": "node server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:vendored": "node scripts/sync-shared.js",
    "backup:db": "node scripts/backup-db.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@descope/node-sdk": "^2.12.0",
    "@descope/react-sdk": "^2.30.2",
    "@sentry/node": "^10.63.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.110.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.41.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.3",
    "stripe": "^22.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "supertest": "^7.2.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-cookie": "^3.0.8",
    "qs": "^6.16.0",
    "browserslist": "^4.28.7",
    "postcss": "^8.5.23",
    "shell-quote": "^1.9.0",
    "@humanfs/node": "^0.16.8"
  }
}
